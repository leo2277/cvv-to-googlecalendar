{
  "name": "cvv-to-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development",
    "build": "vite build --config src/frontend/vite.config.ts && tsc -p src/worker/tsconfig.json --noEmit",
